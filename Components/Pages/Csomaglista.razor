@* 3. Sablon tétel létrehozás / szerkesztés modal *@
@if (VM.IsSablonTetelFormOpen)
{
    <div class="fp-modal-backdrop" role="dialog" aria-modal="true">
        <div class="fp-modal">
            <div class="fp-modal-handle" aria-hidden="true"></div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 mb-0">@(VM.IsSablonTetelEditMode ? "Sablon tétel szerkesztése" : "Új tétel a csomaglistába")</h3>
