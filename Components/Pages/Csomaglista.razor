<ConfirmDialog IsVisible="@(VM.TorlesreVaroTetel is not null)"
               IsBusy="@VM.IsBusy"
               Title="Felszerelés törlése"
               Message="@($"Biztosan törlöd a(z) „{VM.TorlesreVaroTetel?.Nev}” tételt a csomaglistáról?")"
               ConfirmText="Törlés"
               OnConfirm="@(() => VM.ConfirmDeleteAsync())"
               OnCancel="VM.CancelDelete" />

<ConfirmDialog IsVisible="@(VM.TorlesreVaroSablon is not null)"
               IsBusy="@VM.IsBusy"
               Title="Csomaglista törlése"
               Message="@($"Biztosan törlöd a(z) „{VM.TorlesreVaroSablon?.Nev}” újrahasználható csomaglistát és az összes tételét? A már korábban létrehozott túrák felszerelései megmaradnak.")"
               ConfirmText="Törlés"
               OnConfirm="@(() => VM.ConfirmDeleteSablonAsync())"
               OnCancel="VM.CancelDeleteSablon" />

<ConfirmDialog IsVisible="@(VM.TorlesreVaroSablonTetel is not null)"
               IsBusy="@VM.IsBusy"
               Title="Sablon tétel törlése"
               Message="@($"Biztosan törlöd a(z) „{VM.TorlesreVaroSablonTetel?.Nev}” tételt ebből a csomaglistából?")"
               ConfirmText="Törlés"
               OnConfirm="@(() => VM.ConfirmDeleteSablonTetelAsync())"
               OnCancel="VM.CancelDeleteSablonTetel" />

@code {
    [Parameter] public Guid? TuraId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private IDisposable? _refreshRegistration;
    private IDisposable? _backRegistration;

    protected override void OnInitialized()
    {
        VM.StateChanged += OnStateChanged;
        _refreshRegistration = LiveRefresh.RegisterRefreshHandler(
            (isManual, ct) => InvokeAsync(() => VM.RefreshSilentlyAsync(isManual, ct)));
        _backRegistration = BackNavigation.RegisterOverlayHandler(TryCloseOverlay);
    }

    private bool TryCloseOverlay()
    {
        if (VM.TorlesreVaroTetel is not null)
        {
            _ = InvokeAsync(VM.CancelDelete);
            return true;
        }

        if (VM.TorlesreVaroSablon is not null)
        {
            _ = InvokeAsync(VM.CancelDeleteSablon);
            return true;
        }

        if (VM.TorlesreVaroSablonTetel is not null)
        {
            _ = InvokeAsync(VM.CancelDeleteSablonTetel);
            return true;
        }

        if (VM.IsImportSablonOpen)
        {
            _ = InvokeAsync(VM.CloseImportSablonModal);
            return true;
        }

        if (VM.IsSaveAsSablonOpen)
        {
            _ = InvokeAsync(VM.CloseSaveAsSablonModal);
            return true;
        }

        if (VM.IsSablonTetelFormOpen)
        {
            _ = InvokeAsync(VM.CloseSablonTetelForm);
            return true;
        }

        if (VM.IsSablonFormOpen)
        {
            _ = InvokeAsync(VM.CloseSablonForm);
            return true;
        }

        if (VM.IsFormOpen)
        {
            _ = InvokeAsync(VM.CloseForm);
            return true;
        }

        return false;
    }

    protected override async Task OnParametersSetAsync()
    {
        var openSablonok = string.Equals(Tab, "sablonok", StringComparison.OrdinalIgnoreCase);
        await VM.LoadAsync(TuraId, openSablonok);
    }

    private async Task OnTuraSelectedAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var selectedId))
        {
            await VM.ChangeTuraAsync(selectedId);
        }
    }

    private Task HandleSaveAsync() => VM.SaveTetelAsync();
    private Task HandleSaveSablonAsync() => VM.SaveSablonAsync();
    private Task HandleSaveSablonTetelAsync() => VM.SaveSablonTetelAsync();
    private Task HandleSaveCurrentAsSablonAsync() => VM.SaveCurrentTuraAsSablonAsync();

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _backRegistration?.Dispose();
        _refreshRegistration?.Dispose();
        VM.StateChanged -= OnStateChanged;
    }
}
