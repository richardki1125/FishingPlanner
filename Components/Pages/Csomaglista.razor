                            Közös felszerelés
                        </button>
                        <button type="button"
                                class="fp-segmented-btn @(!VM.SzerkesztettSablonTetel.KozosE ? "active" : string.Empty)"
                                @onclick="@(() => VM.OnSablonTetelKozosChanged(false))">
                            Egyéni felszerelés
                        </button>
                    </div>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <button type="button" class="fp-btn fp-btn-outline order-2 order-sm-1" @onclick="VM.CloseSablonTetelForm" disabled="@VM.IsBusy">Mégse</button>
                    <button type="submit" class="fp-btn fp-btn-primary order-1 order-sm-2" disabled="@VM.IsBusy">
                        @(VM.IsBusy ? "Mentés..." : "Mentés")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* 4. Sablon csomaglisták hozzáadása az aktív túrához modal *@
@if (VM.IsImportSablonOpen)
{
    <div class="fp-modal-backdrop" role="dialog" aria-modal="true">
        <div class="fp-modal">
            <div class="fp-modal-handle" aria-hidden="true"></div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h5 mb-0">Csomaglisták hozzáadása</h3>
                    <div class="small fp-muted">Túra: @VM.AktualisTura?.Nev</div>
                </div>
                <button type="button" class="fp-btn fp-btn-icon fp-btn-ghost" @onclick="VM.CloseImportSablonModal" aria-label="Bezárás">
                    <svg class="fp-icon" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <AlertBanner ErrorMessage="@VM.ErrorMessage" OnDismiss="@VM.ClearMessages" />

            <div class="fp-template-pick-list mb-3">
                @foreach (var s in VM.Sablonok)
                {
                    var isChecked = VM.ImportKivalasztottSablonIds.Contains(s.Id);
                    var db = VM.GetSablonTetelSzam(s.Id);

                    <button type="button"
                            class="fp-template-pick-item @(isChecked ? "is-selected" : string.Empty)"
                            @onclick="@(() => VM.ToggleImportSablon(s.Id))">
                        <span class="fp-check-btn @(isChecked ? "checked" : string.Empty)" aria-hidden="true">
                            <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                        </span>
                        <div class="flex-grow-1 min-w-0 text-start">
                            <div class="fw-semibold text-truncate">@s.Nev</div>
                            @if (!string.IsNullOrWhiteSpace(s.Leiras))
                            {
                                <div class="small fp-muted text-truncate">@s.Leiras</div>
                            }
                        </div>
                        <span class="fp-badge fp-badge-neutral flex-shrink-0">@db tétel</span>
                    </button>
                }
            </div>

            @if (VM.Resztvevok.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label" for="import-resztvevo">Egyéni tételek felelőse</label>
                    <select id="import-resztvevo" class="form-select" @bind="VM.ImportEgyeniResztvevoIdString">
                        @foreach (var r in VM.Resztvevok)
                        {
                            <option value="@r.Id.ToString("D")">@r.Nev (@r.Szerepkor)</option>
                        }
                    </select>
                </div>
            }

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                <button type="button" class="fp-btn fp-btn-outline order-2 order-sm-1" @onclick="VM.CloseImportSablonModal" disabled="@VM.IsBusy">Mégse</button>
                <button type="button"
                        class="fp-btn fp-btn-primary order-1 order-sm-2"
                        @onclick="@(() => VM.ApplySelectedSablonokToTuraAsync())"
                        disabled="@(VM.IsBusy || VM.ImportKivalasztottSablonIds.Count == 0)">
                    @(VM.IsBusy ? "Hozzáadás..." : $"Hozzáadás ({VM.ImportKivalasztottTetelSzam} tétel)")
                </button>
            </div>
        </div>
    </div>
}

