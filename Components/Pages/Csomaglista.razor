                    <InputText id="st-nev" class="form-control" @bind-Value="VM.SzerkesztettSablonTetel.Nev" placeholder="pl. Gázfőző + palack, pontymatrac" />
                    <ValidationMessage For="@(() => VM.SzerkesztettSablonTetel.Nev)" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-8">
                        <label class="form-label" for="st-kat">Kategória</label>
                        <InputSelect id="st-kat" class="form-select" @bind-Value="VM.SzerkesztettSablonTetel.Kategoria">
                            @foreach (var kat in CsomaglistaViewModel.Kategoriak)
                            {
                                <option value="@kat">@kat</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => VM.SzerkesztettSablonTetel.Kategoria)" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="st-mennyiseg">Darab</label>
                        <InputNumber id="st-mennyiseg" class="form-control" @bind-Value="VM.SzerkesztettSablonTetel.Mennyiseg" />
                        <ValidationMessage For="@(() => VM.SzerkesztettSablonTetel.Mennyiseg)" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label d-block">Alapértelmezett típus</label>
