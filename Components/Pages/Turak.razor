@page "/"
@page "/turak"
@implements IDisposable
@inject TuraListaViewModel VM
@inject ILiveRefreshService LiveRefresh
@inject IBackNavigationService BackNavigation
@inject NavigationManager Navigation

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title">Horgásztúrák</h1>
        <p class="fp-subtitle">Válassz aktív túrát vagy indíts új közös horgászatot a csapattal.</p>
    </div>
    <div class="fp-header-controls">
        <button type="button" class="fp-btn fp-btn-primary fp-btn-block-mobile" @onclick="VM.OpenCreateTuraFormAsync" disabled="@VM.IsBusy">
            <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            <span>Új túra</span>
        </button>
    </div>
</div>

<AlertBanner ErrorMessage="@VM.ErrorMessage"
             SuccessMessage="@VM.SuccessMessage"
             OnDismiss="@VM.ClearMessages" />

@if (VM.IsLoading)
{
    <LoadingSpinner Message="Horgásztúrák betöltése..." />
}
else if (VM.Turak.Count == 0)
{
    <EmptyState Icon="⛺"
                Title="Még nincs felvett horgásztúra"
                Description="Hozz létre egy új túrát a helyszín, a kezdő és befejező dátum megadásával."
                ActionText="+ Első túra létrehozása"
                OnAction="VM.OpenCreateTuraFormAsync" />
}
else
{
    @* Dátum szerinti szűrő és rendezés *@
    <div class="fp-card mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="fp-chip-scroll">
                <button type="button"
                        class="fp-chip @(VM.DatumSzuroMod == TuraDatumSzuroMod.Mind ? "active" : string.Empty)"
                        @onclick="@(() => VM.SetDatumSzuroMod(TuraDatumSzuroMod.Mind))">
                    Mind (@VM.Turak.Count)
                </button>
                <button type="button"
                        class="fp-chip @(VM.DatumSzuroMod == TuraDatumSzuroMod.AktualisEsKozelgo ? "active" : string.Empty)"
                        @onclick="@(() => VM.SetDatumSzuroMod(TuraDatumSzuroMod.AktualisEsKozelgo))">
                    Aktuális / Közelgő (@VM.AktualisTurakDb)
                </button>
                <button type="button"
                        class="fp-chip @(VM.DatumSzuroMod == TuraDatumSzuroMod.Lejart ? "active" : string.Empty)"
                        @onclick="@(() => VM.SetDatumSzuroMod(TuraDatumSzuroMod.Lejart))">
                    Lejárt (@VM.LejartTurakDb)
                </button>
            </div>

            <button type="button" class="fp-btn fp-btn-sm fp-btn-outline" @onclick="VM.ToggleRendezes" title="Rendezés dátum szerint">
                <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
                <span>@(VM.LegujabbElol ? "Legújabb elöl" : "Legrégebbi elöl")</span>
            </button>
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-4">
                <label class="form-label mb-1" for="szuro-tol">Dátumtól</label>
                <input id="szuro-tol" type="date" class="form-control" @bind="VM.SzuroDatumTol" />
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label mb-1" for="szuro-ig">Dátumig</label>
                <input id="szuro-ig" type="date" class="form-control" @bind="VM.SzuroDatumIg" />
            </div>
            @if (VM.HasActiveFilters)
            {
                <div class="col-12 col-md-4 d-flex justify-content-md-end">
                    <button type="button" class="fp-btn fp-btn-sm fp-btn-ghost w-100 w-md-auto" @onclick="VM.ResetFilters">
                        Szűrők törlése
                    </button>
                </div>
            }
        </div>
    </div>

    @if (VM.SzurtTurak.Count == 0)
    {
        <EmptyState Icon="📅"
                    Title="Nincs a dátumszűrésnek megfelelő túra"
                    Description="Módosítsd a dátumtartományt vagy válassz másik állapotot a szűrőben."
                    ActionText="Szűrők alaphelyzetbe"
                    OnAction="VM.ResetFilters" />
    }
    else
    {
        <div class="row g-3">
            @foreach (var tura in VM.SzurtTurak)
            {
                var resztvevok = VM.GetResztvevok(tura.Id);
                var isActive = VM.ActiveTuraId == tura.Id && !tura.LejartE;

                <div class="col-12 col-lg-6">
                    <div class="fp-card h-100 d-flex flex-column justify-content-between @(isActive ? "fp-card-active" : string.Empty)">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="min-w-0">
                                    <h2 class="h5 mb-1 text-truncate">@tura.Nev</h2>
                                    <div class="d-flex align-items-center gap-1 fp-muted small">
                                        <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span>@tura.Helyszin</span>
                                    </div>
                                </div>
                                @if (tura.LejartE)
                                {
                                    <span class="fp-badge fp-badge-warning flex-shrink-0">Lejárt</span>
                                }
                                else if (isActive)
                                {
                                    <span class="fp-badge fp-badge-primary flex-shrink-0">Aktív</span>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-2 my-3">
                                <span class="fp-badge fp-badge-neutral">
                                    <svg class="fp-icon" style="width:14px;height:14px;" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    <span>@tura.KezdoDatum.ToString("yyyy.MM.dd.") – @tura.VegDatum.ToString("yyyy.MM.dd.") (@tura.NapokSzama nap)</span>
                                </span>
                                <span class="fp-badge fp-badge-neutral">
                                    <svg class="fp-icon" style="width:14px;height:14px;" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    <span>@resztvevok.Count fő</span>
                                </span>
                            </div>

                            @if (resztvevok.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var r in resztvevok)
                                    {
                                        <span class="fp-badge fp-badge-primary" title="@r.Szerepkor">
                                            @r.Nev <span class="opacity-75">· @r.Szerepkor</span>
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="small fp-muted mb-3">Még nincs résztvevő hozzáadva ehhez a túrához.</p>
                            }
                        </div>

                        <div>
                            <div class="fp-trip-modules mb-3">
                                <button type="button" class="fp-trip-module-btn" @onclick="@(() => NavigateToModule(tura.Id, "csomaglista"))">
                                    <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M4 10a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M8 10h8"/></svg>
                                    <span>Csomag</span>
                                </button>
                                <button type="button" class="fp-trip-module-btn" @onclick="@(() => NavigateToModule(tura.Id, "koltsegek"))">
                                    <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                                    <span>Költségek</span>
                                </button>
                                <button type="button" class="fp-trip-module-btn" @onclick="@(() => NavigateToModule(tura.Id, "fogasok"))">
                                    <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M6.5 12c.94-3.46 4.94-6 8.5-6 3.56 0 6.06 2.54 7 6-.94 3.47-3.44 6-7 6s-7.56-2.53-8.5-6Z"/><path d="M18 12v.5"/><path d="M7 10.67C7 8 5.58 5.97 2.73 5.5c-1 1.5-1 5 .23 6.5-1.24 1.5-1.24 5-.23 6.5C5.58 18.03 7 16 7 13.33"/></svg>
                                    <span>Fogások</span>
                                </button>
                                <button type="button" class="fp-trip-module-btn" @onclick="@(() => NavigateToModule(tura.Id, "statisztika"))">
                                    <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                                    <span>Statisztika</span>
                                </button>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-2 pt-2 border-top" style="border-color: var(--fp-border) !important;">
                                <button type="button" class="fp-btn fp-btn-sm fp-btn-outline" @onclick="@(() => VM.OpenResztvevokPanelAsync(tura))">
                                    <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                                    <span>Résztvevők (@resztvevok.Count)</span>
                                </button>

                                <div class="d-flex gap-2">
                                    <button type="button" class="fp-btn fp-btn-icon fp-btn-outline" @onclick="@(() => VM.OpenEditTuraForm(tura))" aria-label="Túra szerkesztése" title="Szerkesztés">
                                        <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                    </button>
                                    <button type="button" class="fp-btn fp-btn-icon fp-btn-danger-soft" @onclick="@(() => VM.RequestDeleteTuraAsync(tura))" aria-label="Túra törlése" title="Törlés">
                                        <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* Túra létrehozás / szerkesztés modal *@
@if (VM.IsTuraFormOpen)
{
    <div class="fp-modal-backdrop" role="dialog" aria-modal="true">
        <div class="fp-modal">
            <div class="fp-modal-handle" aria-hidden="true"></div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 mb-0">@(VM.IsEditMode ? "Túra szerkesztése" : "Új horgásztúra")</h3>
                <button type="button" class="fp-btn fp-btn-icon fp-btn-ghost" @onclick="VM.CloseTuraForm" aria-label="Bezárás">
                    <svg class="fp-icon" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <EditForm Model="VM.SzerkesztettTura" OnValidSubmit="HandleSaveTuraAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="tura-nev">Túra neve</label>
                    <InputText id="tura-nev" class="form-control" @bind-Value="VM.SzerkesztettTura.Nev" placeholder="pl. Balatoni tavaszi bojlis túra" />
                    <ValidationMessage For="@(() => VM.SzerkesztettTura.Nev)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="tura-helyszin">Helyszín / Vízterület</label>
                    <InputText id="tura-helyszin" class="form-control" @bind-Value="VM.SzerkesztettTura.Helyszin" placeholder="pl. Tisza-tó – Abádszalóki-öböl" />
                    <ValidationMessage For="@(() => VM.SzerkesztettTura.Helyszin)" />
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="tura-datum">Kezdő dátum</label>
                        <InputDate id="tura-datum" class="form-control" @bind-Value="VM.SzerkesztettTura.KezdoDatum" />
                        <ValidationMessage For="@(() => VM.SzerkesztettTura.KezdoDatum)" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="tura-vegdatum">Befejező dátum</label>
                        <InputDate id="tura-vegdatum" class="form-control" @bind-Value="VM.SzerkesztettTura.VegDatum" />
                        <ValidationMessage For="@(() => VM.SzerkesztettTura.VegDatum)" />
                    </div>
                </div>

                <div class="mb-3">
                    @if (VM.SzerkesztettTura.VegDatum.Date >= VM.SzerkesztettTura.KezdoDatum.Date)
                    {
                        <span class="fp-badge fp-badge-primary">Időtartam: @VM.SzerkesztettTura.NapokSzama nap</span>
                    }
                </div>

                @* Újrahasználható csomaglisták kiválasztása a túrához *@
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">
                            @(VM.IsEditMode ? "További csomaglisták hozzáadása (opcionális)" : "Csomaglisták hozzáadása (opcionális)")
                        </label>
                        @if (VM.KivalasztottSablonIds.Count > 0)
                        {
                            <span class="fp-badge fp-badge-primary">
                                @VM.KivalasztottSablonIds.Count lista (@VM.KivalasztottSablonTetelekSzama tétel)
                            </span>
                        }
                    </div>

                    @if (VM.CsomaglistaSablonok.Count == 0)
                    {
                        <div class="p-2 px-3 rounded-3 border small fp-muted d-flex flex-wrap justify-content-between align-items-center gap-2"
                             style="background-color: var(--fp-surface-alt); border-color: var(--fp-border) !important;">
                            <span>Még nincs létrehozott csomaglistád.</span>
                            <button type="button"
                                    class="fp-btn fp-btn-sm fp-btn-outline"
                                    @onclick="@(() => { VM.CloseTuraForm(); Navigation.NavigateTo("/csomaglista?tab=sablonok"); })">
                                Csomaglisták kezelése
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="fp-template-pick-list">
                            @foreach (var sablon in VM.CsomaglistaSablonok)
                            {
                                var isSelected = VM.IsSablonKivalasztva(sablon.Id);
                                var tetelDb = VM.GetSablonTetelSzam(sablon.Id);

                                <button type="button"
                                        class="fp-template-pick-item @(isSelected ? "is-selected" : string.Empty)"
                                        @onclick="@(() => VM.ToggleSablonKivalasztas(sablon.Id))">
                                    <span class="fp-check-btn @(isSelected ? "checked" : string.Empty)" aria-hidden="true">
                                        <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                                    </span>
                                    <div class="flex-grow-1 min-w-0 text-start">
                                        <div class="fw-semibold text-truncate">@sablon.Nev</div>
                                        @if (!string.IsNullOrWhiteSpace(sablon.Leiras))
                                        {
                                            <div class="small fp-muted text-truncate">@sablon.Leiras</div>
                                        }
                                    </div>
                                    <span class="fp-badge fp-badge-neutral flex-shrink-0">@tetelDb tétel</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <button type="button" class="fp-btn fp-btn-outline order-2 order-sm-1" @onclick="VM.CloseTuraForm" disabled="@VM.IsBusy">Mégse</button>
                    <button type="submit" class="fp-btn fp-btn-primary order-1 order-sm-2" disabled="@VM.IsBusy">
                        @(VM.IsBusy ? "Mentés..." : "Mentés")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* Résztvevők kezelése modal (regisztrált felhasználókból vagy kézi névvel) *@
@if (VM.ResztvevoKezeltTura is not null)
{
    var aktualisResztvevok = VM.GetResztvevok(VM.ResztvevoKezeltTura.Id);
    var valaszthatoak = VM.ValaszthatoFelhasznalok;

    <div class="fp-modal-backdrop" role="dialog" aria-modal="true">
        <div class="fp-modal">
            <div class="fp-modal-handle" aria-hidden="true"></div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h5 mb-0">Résztvevők kezelése</h3>
                    <div class="small fp-muted">@VM.ResztvevoKezeltTura.Nev</div>
                </div>
                <button type="button" class="fp-btn fp-btn-icon fp-btn-ghost" @onclick="VM.CloseResztvevokPanel" aria-label="Bezárás">
                    <svg class="fp-icon" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <AlertBanner ErrorMessage="@VM.ErrorMessage"
                         SuccessMessage="@VM.SuccessMessage"
                         OnDismiss="@VM.ClearMessages" />

            @if (valaszthatoak.Count == 0)
            {
                <div class="p-3 rounded-3 border mb-3" style="background-color: var(--fp-surface-alt); border-color: var(--fp-border) !important;">
                    <div class="small fp-muted mb-2">
                        Minden jelenleg regisztrált felhasználó már hozzá van adva ehhez a túrához.
                        Ha egy új társad most regisztrált, frissítsd a listát!
                    </div>
                    <button type="button" class="fp-btn fp-btn-sm fp-btn-outline" @onclick="@(() => VM.RefreshRegisztraltFelhasznalokAsync())" disabled="@VM.IsBusy">
                        <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                        <span>Lista frissítése</span>
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="VM.ResztvevoForm" OnValidSubmit="HandleAddResztvevoAsync" class="mb-4">
                    <DataAnnotationsValidator />

                    <div class="row g-2 align-items-start">
                        <div class="col-12 col-sm-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label mb-1" for="resztvevo-user">Regisztrált felhasználó</label>
                                <button type="button"
                                        class="fp-btn fp-btn-ghost p-0"
                                        style="min-height: 24px; font-size: 0.78rem;"
                                        @onclick="@(() => VM.RefreshRegisztraltFelhasznalokAsync())"
                                        disabled="@VM.IsBusy"
                                        title="Regisztrált felhasználók frissítése">
                                    ↻ Frissítés
                                </button>
                            </div>
                            <select id="resztvevo-user" class="form-select" @bind="VM.ResztvevoForm.SelectedUserId">
                                <option value="">-- Válassz horgászt --</option>
                                @foreach (var u in valaszthatoak)
                                {
                                    <option value="@u.Id.ToString("D")">@u.MegjelenitesiNev</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => VM.ResztvevoForm.SelectedUserId)" />
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="resztvevo-szerep">Szerepkör</label>
                            <InputText id="resztvevo-szerep" class="form-control" @bind-Value="VM.ResztvevoForm.Szerepkor" placeholder="pl. Szakács / Bojlis" />
                            <ValidationMessage For="@(() => VM.ResztvevoForm.Szerepkor)" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="fp-btn fp-btn-sm fp-btn-primary w-100" disabled="@VM.IsBusy">
                            <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            <span>@(VM.IsBusy ? "Hozzáadás..." : "Hozzáadás a túrához")</span>
                        </button>
                    </div>
                </EditForm>
            }

            @if (aktualisResztvevok.Count == 0)
            {
                <EmptyState Icon="👥"
                            Title="Még nincs résztvevő"
                            Description="Válaszd ki a fenti listából a regisztrált horgásztársakat." />
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var r in aktualisResztvevok)
                    {
                        var rInit = !string.IsNullOrWhiteSpace(r.Nev) ? r.Nev[..1] : "H";
                        <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded-3 border" style="background-color: var(--fp-surface-alt); border-color: var(--fp-border) !important;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="fp-avatar-circle" style="width: 36px; height: 36px; border-radius: 10px; font-size: 0.88rem;">@rInit</div>
                                <div>
                                    <div class="fw-semibold">@r.Nev</div>
                                    <div class="small fp-muted">@r.Szerepkor</div>
                                </div>
                            </div>
                            <button type="button" class="fp-btn fp-btn-icon fp-btn-danger-soft" @onclick="@(() => VM.RequestDeleteResztvevoAsync(r))" disabled="@VM.IsBusy" aria-label="Eltávolítás" title="Eltávolítás">
                                <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<ConfirmDialog IsVisible="@(VM.TorlesreVaroTura is not null)"
               IsBusy="@VM.IsBusy"
               Title="Túra törlése"
               Message="@($"Biztosan törlöd a(z) „{VM.TorlesreVaroTura?.Nev}” túrát? A hozzá tartozó résztvevők, csomaglista-tételek és fogások is törlődnek.")"
               ConfirmText="Végleges törlés"
               OnConfirm="@(() => VM.ConfirmDeleteTuraAsync())"
               OnCancel="VM.CancelDeleteTura" />

<ConfirmDialog IsVisible="@(VM.TorlesreVaroResztvevo is not null)"
               IsBusy="@VM.IsBusy"
               Title="Résztvevő eltávolítása"
               Message="@($"Biztosan eltávolítod {VM.TorlesreVaroResztvevo?.Nev} résztvevőt a túráról? A korábban feltöltött fogásai és felszerelései megmaradnak, és ha később visszaveszed, minden adata visszakapcsolódik.")"
               ConfirmText="Eltávolítás"
               OnConfirm="@(() => VM.ConfirmDeleteResztvevoAsync())"
               OnCancel="VM.CancelDeleteResztvevo" />

@code {
    private IDisposable? _refreshRegistration;
    private IDisposable? _backRegistration;

    protected override async Task OnInitializedAsync()
    {
        VM.StateChanged += OnStateChanged;
        _refreshRegistration = LiveRefresh.RegisterRefreshHandler(
            (isManual, ct) => InvokeAsync(() => VM.RefreshSilentlyAsync(isManual, ct)));
        _backRegistration = BackNavigation.RegisterOverlayHandler(TryCloseOverlay);
        await VM.LoadAsync();
    }

    private bool TryCloseOverlay()
    {
        if (VM.TorlesreVaroResztvevo is not null)
        {
            _ = InvokeAsync(VM.CancelDeleteResztvevo);
            return true;
        }

        if (VM.TorlesreVaroTura is not null)
        {
            _ = InvokeAsync(VM.CancelDeleteTura);
            return true;
        }

        if (VM.ResztvevoKezeltTura is not null)
        {
            _ = InvokeAsync(VM.CloseResztvevokPanel);
            return true;
        }

        if (VM.IsTuraFormOpen)
        {
            _ = InvokeAsync(VM.CloseTuraForm);
            return true;
        }

        return false;
    }

    private void NavigateToModule(Guid turaId, string module)
    {
        VM.SelectTura(turaId);
        Navigation.NavigateTo($"/{module}/{turaId}");
    }

    private Task HandleSaveTuraAsync() => VM.SaveTuraAsync();

    private Task HandleAddResztvevoAsync() => VM.AddResztvevoAsync();

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _backRegistration?.Dispose();
        _refreshRegistration?.Dispose();
        VM.StateChanged -= OnStateChanged;
    }
}
