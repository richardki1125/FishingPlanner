@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="fp-alert fp-alert-danger" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg class="fp-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>@ErrorMessage</span>
        </div>
        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="fp-btn fp-btn-icon fp-btn-ghost" @onclick="OnDismiss" aria-label="Bezárás">
                <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="fp-alert fp-alert-success" role="status">
        <div class="d-flex align-items-center gap-2">
            <svg class="fp-icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
            <span>@SuccessMessage</span>
        </div>
        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="fp-btn fp-btn-icon fp-btn-ghost" @onclick="OnDismiss" aria-label="Bezárás">
                <svg class="fp-icon fp-icon-sm" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        }
    </div>
}

@code {
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}
